          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Latest failures",
      "description": "The most recent failed process results.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT time, campaign_id, attempt, toString(pid) AS pid, action_kind, status, delivered, error, device_id, installation_id, dawn_instance FROM dusk.process_results WHERE $__timeFilter(time) AND status IN ('failed', 'timed_out', 'denied', 'error') ORDER BY time DESC LIMIT 200",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
