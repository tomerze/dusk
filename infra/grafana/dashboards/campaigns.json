    {
      "id": 6,
      "type": "table",
      "title": "Active campaigns",
      "description": "Running and paused campaigns with their node counts by state.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dusk-inventory"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dusk-inventory"
          },
          "rawSql": "SELECT c.name, c.status, c.kind, c.current_phase AS phase, c.pause_kind, c.pause_reason, c.started_at, c.created_by,\n  coalesce(sum(n.count) FILTER (WHERE n.state = 'succeeded'), 0) AS succeeded,\n  coalesce(sum(n.count) FILTER (WHERE n.state IN ('failed', 'unknown')), 0) AS failed_or_unknown,\n  coalesce(sum(n.count) FILTER (WHERE n.state IN ('pending', 'dispatching', 'dispatched', 'delivered', 'verifying', 'backoff')), 0) AS in_progress,\n  coalesce(sum(n.count), 0) AS nodes\nFROM campaigns c LEFT JOIN campaign_counters n ON n.campaign_id = c.id\nWHERE c.status IN ('running', 'paused') GROUP BY c.id ORDER BY c.started_at DESC NULLS LAST",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "title": "Process results",
      "collapsed": false,
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
