            "type": "grafana-postgresql-datasource",
            "uid": "dusk-inventory"
          },
          "rawSql": "SELECT count(*) AS completed FROM campaigns WHERE status = 'completed' AND $__timeFilter(finished_at)",
          "editorMode": "code",
          "rawQuery": true,
