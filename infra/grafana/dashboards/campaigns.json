    {
      "id": 5,
      "type": "stat",
      "title": "Completed in the time range",
      "description": "Campaigns that finished as completed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dusk-inventory"
      },
      "gridPos": {
        "x": 18,
