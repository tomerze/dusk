    {
      "id": 8,
      "type": "timeseries",
      "title": "Process results by status",
      "description": "Final dusk.process-results per interval.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT $__timeInterval(time) AS t, status, count() AS results FROM dusk.process_results WHERE $__timeFilter(time) AND status != 'started' GROUP BY t, status ORDER BY t",
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failures by action",
      "description": "failed, timed_out, denied and error results by action kind.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT $__timeInterval(time) AS t, action_kind, count() AS results FROM dusk.process_results WHERE $__timeFilter(time) AND status IN ('failed', 'timed_out', 'denied', 'error') GROUP BY t, action_kind ORDER BY t",
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
