            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Dispatch to result",
      "description": "Median and 99th percentile of the time from dawn starting a dispatch to its final result.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT $__timeInterval(time) AS t, quantile(0.5)(dateDiff('millisecond', started_at, finished_at) / 1000) AS median, quantile(0.99)(dateDiff('millisecond', started_at, finished_at) / 1000) AS p99 FROM dusk.process_results WHERE $__timeFilter(time) AND status != 'started' AND finished_at IS NOT NULL GROUP BY t ORDER BY t",
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
