{
  "uid": "dusk-ledger",
  "title": "Ledger",
  "description": "Every call nightfall forwarded, who made it, how it ended, and whether the hash chains are intact.",
  "tags": [
    "dusk",
    "ledger"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "dusk"
      ],
      "asDropdown": true,
      "title": "Dusk dashboards"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Chains",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Broken chains",
      "description": "(instance, partition) chains with a gap, a broken link or two entries at one sequence in the last hour.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT countIf(NOT intact) AS broken FROM dusk.ledger_chain(since = now64(9) - INTERVAL 1 HOUR)",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Denied calls",
      "description": "Calls refused by permissions in the time range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT count() AS denied FROM dusk.ledger WHERE $__timeFilter(time) AND kind = 'call' AND result_code = 'denied'",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate limited calls",
      "description": "Calls refused by limits in the time range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT count() AS rate_limited FROM dusk.ledger WHERE $__timeFilter(time) AND kind = 'call' AND result_code = 'rate_limited'",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Processes without a pid",
      "description": "Dusk.process calls that named no pid, so the node chose one; twilight counts them and raises no alert.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT count() AS unattributed FROM dusk.ledger WHERE $__timeFilter(time) AND kind = 'call' AND action = 'Dusk.process' AND pid = 0",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Chain status",
      "description": "Each (instance, partition) chain over the last hour.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT instance, partition, entries, first_sequence, last_sequence, gaps, broken_links, conflicting_entries, last_checkpoint_sequence, last_checkpoint_time, last_entry_time, intact FROM dusk.ledger_chain(since = now64(9) - INTERVAL 1 HOUR) ORDER BY instance, partition",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "title": "Calls",
      "collapsed": false,
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Calls by action",
      "description": "Forwarded calls per interval by interface and method.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT $__timeInterval(time) AS t, action, count() AS calls FROM dusk.ledger WHERE $__timeFilter(time) AND kind = 'call' GROUP BY t, action ORDER BY t",
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Calls by principal",
      "description": "Forwarded calls per interval by calling principal.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT $__timeInterval(time) AS t, principal, count() AS calls FROM dusk.ledger WHERE $__timeFilter(time) AND kind = 'call' GROUP BY t, principal ORDER BY t",
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Results by code",
      "description": "Result entries and refused calls per interval by result code.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT $__timeInterval(time) AS t, result_code, count() AS entries FROM dusk.ledger WHERE $__timeFilter(time) AND result_code IS NOT NULL GROUP BY t, result_code ORDER BY t",
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Denied and rate limited",
      "description": "Refused calls per interval by principal and kind of refusal.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT $__timeInterval(time) AS t, concat(principal, ' ', result_code) AS refusal, count() AS calls FROM dusk.ledger WHERE $__timeFilter(time) AND kind = 'call' AND result_code IN ('denied', 'rate_limited') GROUP BY t, refusal ORDER BY t",
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Security events",
      "description": "Refused sessions, binding conflicts, rejected RPC messages and quarantine overrides.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT time, event, instance, principal, device_id, installation_id, namespace_id, toString(pid) AS pid, event_detail FROM dusk.ledger WHERE $__timeFilter(time) AND event IN ('session_refused', 'binding_conflict', 'rpc_rejected', 'quarantine_override', 'membrane_dropped') ORDER BY time DESC LIMIT 200",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
