    {
      "id": 9,
      "type": "timeseries",
      "title": "Evidence copies per second",
      "description": "Ledger entries Vector wrote to the object-locked evidence bucket.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "dusk-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "dusk-clickhouse"
          },
          "rawSql": "SELECT t, series, sum(increase) / $__interval_s AS per_second FROM (\n  SELECT t, series, instance, greatest(highest - lagInFrame(highest, 1, highest) OVER (PARTITION BY series, instance, attribute_set ORDER BY t), 0) AS increase\n  FROM (\n    SELECT $__timeInterval(time) AS t, attributes['component_id'] AS series, resource_attributes['service.instance.id'] AS instance, toString(attributes) AS attribute_set, max(value) AS highest\n    FROM dusk.otel_metrics\n    WHERE $__timeFilter(time) AND service_name = 'vector' AND metric_name IN ('vector_component_sent_events_total', 'vector_component_sent_events') AND attributes['component_id'] = 'evidence_ledger'\n    GROUP BY t, series, instance, attribute_set))\nGROUP BY t, series ORDER BY t",
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
