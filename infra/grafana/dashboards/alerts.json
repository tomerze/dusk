    {
      "id": 6,
      "type": "table",
      "title": "Unresolved alerts",
      "description": "Every alert not resolved yet, newest first.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dusk-inventory"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dusk-inventory"
          },
          "rawSql": "SELECT time, severity, kind, occurrences, last_seen_at, acknowledged_by, acknowledged_at, detail::text AS detail FROM alerts WHERE resolved_at IS NULL ORDER BY CASE severity WHEN 'critical' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 ELSE 3 END, time DESC LIMIT 500",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Alerts raised by kind",
      "description": "New alerts per interval.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dusk-inventory"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dusk-inventory"
          },
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval), kind AS metric, count(*) AS alerts FROM alerts WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
