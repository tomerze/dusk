          "rawSql": "SELECT t, series, sum(increase) / $__interval_s AS per_second FROM (\n  SELECT t, series, instance, greatest(highest - lagInFrame(highest, 1, highest) OVER (PARTITION BY series, instance, attribute_set ORDER BY t), 0) AS increase\n  FROM (\n    SELECT $__timeInterval(time) AS t, attributes['component_id'] AS series, resource_attributes['service.instance.id'] AS instance, toString(attributes) AS attribute_set, max(value) AS highest\n    FROM dusk.otel_metrics\n    WHERE $__timeFilter(time) AND service_name = 'vector' AND metric_name IN ('vector_component_discarded_events_total', 'vector_component_discarded_events')\n    GROUP BY t, series, instance, attribute_set))\nGROUP BY t, series ORDER BY t",
          "editorType": "sql",
