        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "dusk-clickhouse"
        },
        "query": {
          "rawSql": "SELECT DISTINCT metric_name FROM dusk.otel_metrics WHERE service_name = 'twilight' AND time > now() - INTERVAL 1 DAY ORDER BY metric_name",
          "refId": "variable"
        },
        "definition": "SELECT DISTINCT metric_name FROM dusk.otel_metrics WHERE service_name = 'twilight' AND time > now() - INTERVAL 1 DAY ORDER BY metric_name",
