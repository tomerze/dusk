{
  "spec": {
    "display": {
      "name": "Dusk connections",
      "description": "Nodes connecting to and disconnecting from nightfall."
    },
    "variables": [],
    "panels": {
      "connects": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Connects",
            "description": "Node sessions nightfall opened."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "clickhouse_sql",
                        "spec": {
                          "name": "A",
                          "query": "SELECT count() AS value FROM dusk.connections WHERE time >= $start_datetime AND time < $end_datetime AND event = 'connected'",
                          "disabled": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "connects-and-disconnects": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Connects and disconnects",
            "description": "Node sessions opened and ended per interval."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "clickhouse_sql",
                        "spec": {
                          "name": "A",
                          "query": "SELECT toStartOfInterval(time, toIntervalSecond(greatest(60, intDiv($end_timestamp - $start_timestamp, 120)))) AS ts, event, count() AS value FROM dusk.connections WHERE time >= $start_datetime AND time < $end_datetime GROUP BY ts, event ORDER BY ts",
                          "disabled": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "disconnects": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Disconnects",
            "description": "Node sessions that ended."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "clickhouse_sql",
                        "spec": {
                          "name": "A",
                          "query": "SELECT count() AS value FROM dusk.connections WHERE time >= $start_datetime AND time < $end_datetime AND event = 'disconnected'",
                          "disabled": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "disconnects-by-reason": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Disconnects by reason",
            "description": "Ended node sessions per interval, by reason."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "clickhouse_sql",
                        "spec": {
                          "name": "A",
                          "query": "SELECT toStartOfInterval(time, toIntervalSecond(greatest(60, intDiv($end_timestamp - $start_timestamp, 120)))) AS ts, disconnect_reason AS reason, count() AS value FROM dusk.connections WHERE time >= $start_datetime AND time < $end_datetime AND event = 'disconnected' GROUP BY ts, reason ORDER BY ts",
                          "disabled": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "disconnects-by-reason-table": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Disconnects by reason",
            "description": "Ended node sessions over the time range, by reason."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "columnUnits": null,
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "clickhouse_sql",
                        "spec": {
                          "name": "A",
                          "query": "SELECT disconnect_reason AS reason, count() AS disconnects FROM dusk.connections WHERE time >= $start_datetime AND time < $end_datetime AND event = 'disconnected' GROUP BY reason ORDER BY disconnects DESC",
                          "disabled": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/connects"
              }
            },
            {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/disconnects"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 9,
              "content": {
                "$ref": "#/spec/panels/disconnects-by-reason-table"
              }
            },
            {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/connects-and-disconnects"
              }
            },
            {
              "x": 0,
              "y": 9,
              "width": 12,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/disconnects-by-reason"
              }
            }
          ]
        }
      }
    ],
    "duration": "6h",
    "refreshInterval": "",
    "links": null
  },
  "tags": [
    {
      "key": "dusk",
      "value": "connections"
    }
  ],
  "image": ""
}