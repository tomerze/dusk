{
  "spec": {
    "display": {
      "name": "Dusk enrollments",
      "description": "Requests to nightfall's provisioning listener to assign, enroll and renew nodes."
    },
    "variables": [],
    "panels": {
      "denied": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Denied",
            "description": "Requests nightfall refused."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "clickhouse_sql",
                        "spec": {
                          "name": "A",
                          "query": "SELECT count() AS value FROM dusk.enrollments WHERE time >= $start_datetime AND time < $end_datetime AND outcome = 'denied'",
                          "disabled": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "enrollment-rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Enrollment rate",
            "description": "Requests to enroll a node, per minute."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "clickhouse_sql",
                        "spec": {
                          "name": "A",
                          "query": "SELECT toStartOfInterval(time, toIntervalSecond(greatest(60, intDiv($end_timestamp - $start_timestamp, 120)))) AS ts, count() * 60 / greatest(60, intDiv($end_timestamp - $start_timestamp, 120)) AS value FROM dusk.enrollments WHERE time >= $start_datetime AND time < $end_datetime AND operation = 'enroll' GROUP BY ts ORDER BY ts",
                          "disabled": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "enrollments": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Enrollments",
            "description": "Requests to enroll a node."
          },
          "plugin": {
