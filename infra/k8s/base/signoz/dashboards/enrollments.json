      "outcomes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Outcomes by operation and credential kind",
            "description": "Requests over the time range."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "columnUnits": null,
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "clickhouse_sql",
                        "spec": {
                          "name": "A",
                          "query": "SELECT operation, credential_kind, outcome, count() AS requests FROM dusk.enrollments WHERE time >= $start_datetime AND time < $end_datetime GROUP BY operation, credential_kind, outcome ORDER BY operation, credential_kind, requests DESC",
                          "disabled": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
