message enrollments {
  required int64 time (TIMESTAMP(NANOS,true));
  required binary id (STRING);
  required binary schema (STRING);
  required binary operation (STRING);
  required binary outcome (STRING);
  optional binary reason (STRING);
  required binary device_id (STRING);
  required binary installation_id (STRING);
  optional binary tenant (STRING);
  required binary credential_kind (STRING);
  optional binary credential_ref (STRING);
  optional binary hardware_fingerprint_hash (STRING);
  required binary remote_address (STRING);
  optional binary cert_serial (STRING);
  optional binary cert_fingerprint (STRING);
  optional int64 cert_not_after (TIMESTAMP(NANOS,true));
  optional binary dusk_version (STRING);
  optional binary impl (STRING);
  optional binary target_os (STRING);
  optional binary target_arch (STRING);
  optional binary hostname (STRING);
  required binary instance (STRING);
  required int32 kafka_partition (INTEGER(32,false));
  required int64 kafka_offset (INTEGER(64,false));
}
