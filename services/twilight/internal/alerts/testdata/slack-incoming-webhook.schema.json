{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slack incoming webhook message with Block Kit header and section blocks, as https://docs.slack.dev/messaging/sending-messages-using-incoming-webhooks and the header and section block references document them",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "blocks"],
  "properties": {
    "text": {"type": "string", "minLength": 1},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": {"const": "header"},
              "text": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "text"],
                "properties": {"type": {"const": "plain_text"}, "text": {"type": "string", "minLength": 1, "maxLength": 150}}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "anyOf": [{"required": ["text"]}, {"required": ["fields"]}],
            "properties": {
              "type": {"const": "section"},
              "text": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "text"],
                "properties": {"type": {"enum": ["mrkdwn", "plain_text"]}, "text": {"type": "string", "minLength": 1, "maxLength": 3000}}
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "text"],
                  "properties": {"type": {"enum": ["mrkdwn", "plain_text"]}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}}
                }
              }
            }
          }
        ]
      }
    }
  }
}
