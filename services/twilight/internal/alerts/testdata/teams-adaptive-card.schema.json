{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Microsoft Teams incoming webhook message carrying an Adaptive Card, as https://learn.microsoft.com/en-us/microsoftteams/platform/webhooks-and-connectors/how-to/add-incoming-webhook documents it, with the TextBlock, FactSet and Action.OpenUrl elements of Adaptive Cards 1.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "attachments"],
  "properties": {
    "type": {"const": "message"},
    "attachments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contentType", "content"],
        "properties": {
          "contentType": {"const": "application/vnd.microsoft.card.adaptive"},
          "contentUrl": {"type": "null"},
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["$schema", "type", "version", "body"],
            "properties": {
              "$schema": {"const": "http://adaptivecards.io/schemas/adaptive-card.json"},
              "type": {"const": "AdaptiveCard"},
              "version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "1.5"]},
              "body": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "text"],
                      "properties": {
                        "type": {"const": "TextBlock"},
                        "text": {"type": "string", "minLength": 1},
                        "weight": {"enum": ["Default", "Lighter", "Bolder"]},
                        "size": {"enum": ["Default", "Small", "Medium", "Large", "ExtraLarge"]},
                        "color": {"enum": ["Default", "Dark", "Light", "Accent", "Good", "Warning", "Attention"]},
                        "isSubtle": {"type": "boolean"},
                        "wrap": {"type": "boolean"},
                        "spacing": {"enum": ["None", "Small", "Default", "Medium", "Large", "ExtraLarge", "Padding"]}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "facts"],
                      "properties": {
                        "type": {"const": "FactSet"},
                        "facts": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["title", "value"],
                            "properties": {"title": {"type": "string"}, "value": {"type": "string"}}
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "title", "url"],
                  "properties": {"type": {"const": "Action.OpenUrl"}, "title": {"type": "string", "minLength": 1}, "url": {"type": "string", "pattern": "^https?://"}}
                }
              }
            }
          }
        }
      }
    }
  }
}
