{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "description": "UUID version 7, lowercase.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "description": "RFC 3339 in UTC with exactly nine fractional digits.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "uuid": {
      "description": "Canonical lowercase UUID of any version.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "namespace_id": {
      "description": "Namespace.id as 16 lowercase zero-padded hex digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "pid": {
      "description": "A process id: a u64 as a decimal string, 0 to 18446744073709551615.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "not": {
        "type": "string",
        "pattern": "^([2-9][0-9]{19}|19[0-9]{18}|18[5-9][0-9]{17}|184[5-9][0-9]{16}|1844[7-9][0-9]{15}|18446[8-9][0-9]{14}|184467[5-9][0-9]{13}|1844674[5-9][0-9]{12}|18446744[1-9][0-9]{11}|184467440[8-9][0-9]{10}|1844674407[4-9][0-9]{9}|18446744073[8-9][0-9]{8}|184467440737[1-9][0-9]{7}|18446744073709[6-9][0-9]{5}|184467440737095[6-9][0-9]{4}|1844674407370955[2-9][0-9]{3}|18446744073709551[7-9][0-9]{2}|184467440737095516[2-9][0-9]|1844674407370955161[6-9])$"
      }
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "hash": {
      "description": "SHA-256 or HMAC-SHA256 output as 64 lowercase hex digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instance": {
      "description": "A service instance name. It is a Kafka key segment, so it never holds a slash.",
      "type": "string",
      "pattern": "^[^/]+$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,63}$"
    },
    "remote_address": {
      "description": "ip:port, an IPv6 address in brackets.",
      "type": "string",
      "pattern": "^(\\[[0-9a-f:.]+(%[^\\]]+)?\\]|[0-9]{1,3}(\\.[0-9]{1,3}){3}):[0-9]{1,5}$"
    },
    "inner_address": {
      "description": "host:port, an IPv6 address in brackets.",
      "type": "string",
      "pattern": "^(\\[[0-9a-f:.]+\\]|[A-Za-z0-9.-]+):[0-9]{1,5}$"
    }
  }
}
