{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "time",
    "operation",
    "reservation",
    "credential_kind",
    "credential",
    "limit",
    "device_id",
    "installation_id",
    "instance"
  ],
  "properties": {
    "schema": { "const": "dusk.credential-quota/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "time": { "$ref": "common.schema.json#/$defs/timestamp" },
    "operation": { "enum": ["reserve", "release"] },
    "reservation": { "$ref": "common.schema.json#/$defs/id" },
    "credential_kind": { "enum": ["fleet_token", "install_token"] },
    "credential": {
      "description": "The fleet token entry's name or the id of the key that signed the install token.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 9007199254740992 },
    "device_id": { "$ref": "common.schema.json#/$defs/device_id" },
    "installation_id": { "$ref": "common.schema.json#/$defs/installation_id" },
    "instance": { "$ref": "common.schema.json#/$defs/instance" }
  }
}
